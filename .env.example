# NEXUS Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# General Environment
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_SECRET_KEY=nexus-development-insecure-secret-key-replace-in-production

# Secure Gateway (mTLS & HTTP)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8443
GATEWAY_TLS_ENABLED=true
GATEWAY_MTLS_ENABLED=true
GATEWAY_CERT_FILE=certs/gateway.crt
GATEWAY_KEY_FILE=certs/gateway.key
GATEWAY_CA_FILE=certs/ca.crt
GATEWAY_RATE_LIMIT_PER_SEC=1000

# Redis & Redis Streams
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_STREAM_NAME=nexus:telemetry:stream
REDIS_CONSUMER_GROUP=nexus:consumers:telemetry
REDIS_DLQ_STREAM=nexus:telemetry:dlq

# PostgreSQL + TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_secure_password
DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_secure_password@localhost:5432/nexus_db

# Digital Twin API Service
TWIN_API_HOST=0.0.0.0
TWIN_API_PORT=8000

# Local AI / LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=15
LLM_MOCK_FALLBACK=true

# Sensor Simulator Configuration
SIMULATOR_NUM_DEVICES=100
SIMULATOR_FREQUENCY_HZ=1.0
SIMULATOR_RANDOM_SEED=42
SIMULATOR_FAULT_LOSS_RATE=0.0
SIMULATOR_FAULT_DELAY_MS=0
SIMULATOR_FAULT_NOISE_LEVEL=low
SIMULATOR_OUT_OF_ORDER=false
SIMULATOR_DUPLICATES=false
